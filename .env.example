# SQLite 파일 경로 (기본: ./data/app.db)
DATABASE_PATH=./data/app.db

# DART Open API 키 (https://opendart.fss.or.kr) — 개발 3단계에서 사용
DART_API_KEY=

# SEC EDGAR 요청 시 User-Agent (예: "Your Name your@email.com") — 개발 3단계에서 사용
SEC_USER_AGENT=

# 설정하면 POST /api/candidates 호출에 Authorization: Bearer <토큰>이 필요하다
IMPORT_API_TOKEN=
