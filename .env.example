# SQLite 파일 경로 (기본: ./data/app.db)
DATABASE_PATH=./data/app.db

# DART Open API 키 (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=

# SEC EDGAR는 API 키가 없고, 연락처가 담긴 User-Agent만 요구한다. 공백이 있으니 따옴표로 감싼다
SEC_USER_AGENT="Your Name your@email.com"

# 설정하면 POST /api/candidates 호출에 Authorization: Bearer <토큰>이 필요하다
IMPORT_API_TOKEN=
